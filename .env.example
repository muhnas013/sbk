# ---------------------------------------------------------------------------
# PT Sabhumi Karya Barito — Environment Variables
# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env.
# ---------------------------------------------------------------------------

# --- Aplikasi ---
NODE_ENV=development
# Lokal: http://localhost:3000 — Produksi: https://sabhumikaryabarito.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Domain produksi tanpa protokol; dipakai Caddy untuk menerbitkan sertifikat.
SITE_DOMAIN=sabhumikaryabarito.com
ACME_EMAIL=

# --- Database ---
# WAJIB diisi. Buat kata sandi acak, mis. dengan: openssl rand -base64 24
# Nilai POSTGRES_PASSWORD harus sama dengan yang tertulis di DATABASE_URI.
DATABASE_URI=postgres://sbk:GANTI_KATA_SANDI_INI@localhost:5432/sbk
POSTGRES_USER=sbk
POSTGRES_PASSWORD=
POSTGRES_DB=sbk

# --- Payload ---
# Wajib. Buat dengan: openssl rand -base64 32
PAYLOAD_SECRET=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=PT Sabhumi Karya Barito
EMAIL_FROM_ADDRESS=noreply@example.com
# Penerima notifikasi form kontak & lamaran kerja
EMAIL_TO_CONTACT=
EMAIL_TO_HR=

# --- Proteksi Form (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Retensi Data ---
# Lamaran kerja lebih tua dari ini dihapus otomatis (UU PDP).
APPLICATION_RETENTION_MONTHS=12
