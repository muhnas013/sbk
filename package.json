{
  "name": "sbk-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Website Company Profile PT Sabhumi Karya Barito",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css,scss}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css,scss}\"",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "seed": "tsx --env-file=.env src/scripts/seed.ts",
    "seed:container": "tsx src/scripts/seed.ts",
    "prepare": "husky",
    "purge:applications": "tsx --env-file=.env src/scripts/purge-applications.ts",
    "verify:contact": "tsx --env-file=.env src/scripts/verify-contact.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "^3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-redirects": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "graphql": "^16.11.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.7",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.9.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.7",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.0",
    "prettier": "^3.6.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "undici": "^7.29.1",
    "nodemailer": "^10.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,json,css,scss}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "unrs-resolver@1.12.2": true
  }
}
